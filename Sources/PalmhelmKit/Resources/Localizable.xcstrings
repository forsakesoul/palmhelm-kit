      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[{target}] The agent has waited for an approval or an answer for over {minutes} min. Handle it in the terminal; to abandon this command, send \"重置占用 {name}\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[{target}] agent 等待审批或回答已超过 {minutes} 分钟，仍未处理。请到终端处理；若要放弃这条命令，发「重置占用 {name}」。"
          }
        }
      },
      "shouldGenerateSymbols": false
    },
    "bridge.msg.native.unknown.instance_lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[{target}] The target instance ended or was replaced; the result of this command is unknown. The target is paused and nothing was resent automatically. After confirming, send \"重置占用 项目名\" (项目名 = the project name)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
